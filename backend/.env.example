# 复制本文件为 .env 后填写真实密码
DATABASE_URL=mysql+aiomysql://root:你的密码@localhost:3306/campustalk?charset=utf8mb4
# Redis 广播总线（消息跨进程投递用，硬依赖）。
# Windows 本机安装 Memurai 后保持默认即可；带密码写法：redis://:密码@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
# 令牌签名密钥（HS256），建议至少 32 字节。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RECALL_WINDOW_SECONDS=180
UPLOAD_DIR=uploads
